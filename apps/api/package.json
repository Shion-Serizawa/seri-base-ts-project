{
  "name": "@seri/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings src/worker-configuration.d.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.0",
    "@seri/contract": "workspace:*",
    "@seri/db": "workspace:*",
    "@seri/domain": "workspace:*",
    "better-auth": "1.6.29",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.21.3",
    "@cloudflare/workers-types": "5.20260816.1",
    "@seri/tsconfig": "workspace:*",
    "@seri/vitest-config": "workspace:*"
  }
}
