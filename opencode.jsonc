{
  "$schema": "https://opencode.ai/config.json",

  // OpenAI-compatible local gateway. Keep the credential outside this file.
  "model": "local-openai/default",
  "provider": {
    "local-openai": {
      "name": "Local OpenAI-compatible gateway",
      "npm": "@ai-sdk/openai-compatible",
      "env": ["LOCAL_OPENAI_API_KEY"],
      "options": {
        "baseURL": "http://127.0.0.1:8888/v1",
        "apiKey": "{env:LOCAL_OPENAI_API_KEY}",
      },
      "models": {
        "default": {
          "id": "{env:LOCAL_OPENAI_MODEL}",
          "name": "Local gateway model",
        },
      },
    },
  },
}
