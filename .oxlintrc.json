{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  // ---------------------------------------------------------------------------
  // リポジトリの形を知っている部分だけをここに置く（ADR 0010 の C 層）。
  //
  // カテゴリ・プラグイン・ルール本体は @seri/base-tooling が配っている base 設定にある。
  // ここを空にしても lint が緩まないよう、⑪ は extends を解決した**実効設定**に対して
  // ポリシーを検証する（scripts/fitness の ⑪）。
  // ---------------------------------------------------------------------------
  "extends": ["./node_modules/@seri/base-tooling/src/oxlint/base.json"],

  "overrides": [
    {
      // -------------------------------------------------------------------
      // アーキテクチャ境界（適応度関数 ⑦）
      //
      // dependency-cruiser は TypeScript 7 の API 非対応で走査できないため、
      // 層の依存方向は oxlint の no-restricted-imports で表現する。
      // 循環依存は import/no-cycle が全体に対して禁止している。
      //
      // `paths`（完全一致）ではなく `patterns`（glob）を使う。完全一致では
      // `@seri/db` は止まっても `@seri/db/schema` のようなサブパス import が素通りするため。
      // 各層は「許可する依存先の allowlist」として書く（`!` が許可）。
      // -------------------------------------------------------------------
      "files": ["packages/contract/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@seri/*", "@seri/*/**"],
                "message": "contract は最下層。他のワークスペースに依存できない"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/domain/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@seri/*", "@seri/*/**", "!@seri/contract", "!@seri/contract/**"],
                "message": "domain が依存できるのは @seri/contract だけ（純粋なロジックの層）"
              }
            ]
          }
        ],
        // domain は決定的でなければならない。現在時刻や乱数は引数で受け取る。
        // ここを許すとテストが時刻依存になり、ミューテーションテストも不安定になる
        "no-restricted-properties": [
          "error",
          {
            "object": "Date",
            "property": "now",
            "message": "domain は決定的に保つ。現在時刻は引数で受け取る"
          },
          {
            "object": "Math",
            "property": "random",
            "message": "domain は決定的に保つ。乱数は引数で受け取る"
          },
          {
            "object": "crypto",
            "property": "randomUUID",
            "message": "domain は決定的に保つ。ID の生成は呼び出し側で行う"
          }
        ]
      }
    },
    {
      "files": ["packages/db/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@seri/*", "@seri/*/**", "!@seri/contract", "!@seri/contract/**"],
                "message": "db が依存できるのは @seri/contract だけ（スキーマの層）"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/api/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@seri/*",
                  "@seri/*/**",
                  "!@seri/contract",
                  "!@seri/contract/**",
                  "!@seri/domain",
                  "!@seri/domain/**"
                ],
                "message": "api が依存できるのは contract / domain と、テーブル境界（*-table.ts）経由の db だけ"
              }
            ]
          }
        ]
      }
    },
    {
      // -------------------------------------------------------------------
      // 認可スコープの境界（適応度関数 ⑭）
      //
      // 生の Drizzle テーブルに触れるのは `*-table.ts` と better-auth の初期化だけ。
      // それ以外のファイルは `@seri/db` を import できないので、
      // where 句にセッションのユーザーを付け忘れたクエリを書く経路が存在しない。
      // 後方の override が同じルールを上書きするため、この項目は api の層規則より後に置く。
      // -------------------------------------------------------------------
      "files": ["apps/api/src/repositories/*-table.ts", "apps/api/src/lib/auth.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@seri/*",
                  "@seri/*/**",
                  "!@seri/contract",
                  "!@seri/contract/**",
                  "!@seri/db",
                  "!@seri/db/**",
                  "!@seri/domain",
                  "!@seri/domain/**"
                ],
                "message": "api が依存できるのは contract / db / domain だけ（web には依存できない）"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@seri/*",
                  "@seri/*/**",
                  "!@seri/contract",
                  "!@seri/contract/**",
                  "!@seri/domain",
                  "!@seri/domain/**"
                ],
                "message": "web が依存できるのは contract / domain だけ。API の型は契約から得る（@seri/api と @seri/db は実行時も型も禁止）"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/*/src/worker.ts"],
      "rules": {
        // Cloudflare Workers のモジュール形式はデフォルトエクスポートを要求する
        "import/no-default-export": "off"
      }
    },
    {
      // TanStack Router のファイルベースルーティングは default export を要求する
      "files": ["**/routes/**/*.tsx"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      // TanStack Router のファイルベースルーティングは __root.tsx など
      // 規約で決まった名前を要求するため、ファイル名の規則から除外する
      "files": ["apps/web/src/routes/**"],
      "rules": {
        "unicorn/filename-case": "off"
      }
    }
  ],

  // extends では継承されないため（実測）、適用範囲はルートに置く。
  // ⑪ が LINT_IGNORE_PATTERNS と完全一致で固定している。
  "ignorePatterns": [
    "**/dist/**",
    "**/coverage/**",
    "**/reports/**",
    "**/.wrangler/**",
    "**/.turbo/**",
    "**/.stryker-tmp/**",
    "**/node_modules/**",
    "**/*.gen.ts",
    "**/routeTree.gen.ts",
    "**/worker-configuration.d.ts"
  ]
}
